              "cells": [
                "塑料基板2~4层",
                "载带基板1~2层",
                "细间距球栅",
                "微型球栅"
              ]
            },
            {
              "label": "球间距",
              "cells": [
                "1.27mm",
                "0.65~1mm",
                "1mm",
                "0.5mm"
              ]
            },
            {
              "label": "记忆要点",
              "cells": [
                "P=塑料",
                "T=载带",
                "F=细间距",
                "u=微型"
              ]
            }
          ]
        },
