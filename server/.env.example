# PigeonLib 同步后端配置示例。复制为 .env 后按需修改。
# 真实口令/密钥由你本机填写;.env 不会被提交(见 .gitignore)。

# 监听端口(默认 8787)
PORT=8787

# 运行环境:production 时会话 cookie 启用 Secure(需 HTTPS)
NODE_ENV=development

# 会话有效期(天)
SESSION_TTL_DAYS=30

# 允许携带 cookie 的前端源(逗号分隔)。开发默认 Vite 的 5173。
# 生产改为你的前端域名,如 https://lib.example.com
CORS_ORIGINS=http://localhost:5173

# 前面隔了几层反向代理(IIS / Nginx)。**反代部署必须设为 1**,
# 否则限流按反代地址归并 —— 一个用户连错几次密码,全站都会被 429 挡住。
# 直连公网(无反代)保持 0:此时若信任 X-Forwarded-For,攻击者伪造该头即可绕过限流。
TRUST_PROXY=0

# 可选:启动时若该用户不存在则自动建为管理员。
# **公网部署强烈建议配置**:不配置时第一个注册的用户会自动成为管理员,
# 部署到你自己注册之间的窗口里,任何人抢注即可拿到管理权。
# SEED_ADMIN_USER=admin
# SEED_ADMIN_PASS=change-me-please
