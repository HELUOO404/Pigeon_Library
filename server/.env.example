# PigeonLib 同步后端配置示例。复制为 .env 后按需修改。
# 真实口令/密钥由你本机填写;.env 不会被提交(见 .gitignore)。

# 监听端口(默认 8787)
PORT=8787

# 可选部署路径。生产服务器可把数据和静态站放在 server/ 外部,
# 便于替换代码时保留数据库/课程；相对路径以 server/ 为基准。
# DATA_DIR=../data
# STATIC_DIR=../www

# 运行环境:production 时会话 cookie 启用 Secure(需 HTTPS)
NODE_ENV=development

# 会话有效期(天)
SESSION_TTL_DAYS=30

# 允许携带 cookie 的前端源(逗号分隔)。开发默认 Vite 的 5173。
# 生产改为你的前端域名,如 https://lib.example.com
CORS_ORIGINS=http://localhost:5173

# 本机是否有反向代理(IIS / Nginx / cloudflared)。**反代部署设为 loopback**,
# 仅信任环回代理链中的 X-Forwarded-For;否则所有用户会按反代地址归并而互相 429。
# 直连公网保持 0:此时若信任 X-Forwarded-For,攻击者伪造该头即可绕过限流。
TRUST_PROXY=0

# 可选:启动时若该用户不存在则自动建为管理员。
# **公网部署强烈建议配置**:不配置时第一个注册的用户会自动成为管理员,
# 部署到你自己注册之间的窗口里,任何人抢注即可拿到管理权。
# SEED_ADMIN_USER=admin
# SEED_ADMIN_PASS=change-me-please
